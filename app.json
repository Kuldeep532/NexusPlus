{
  "expo": {
    "name": "Nexus Plus",
    "slug": "nexus-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/generated-branding/nexus-plus-1024.png",
    "scheme": "nexus-plus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/generated-branding/nexus-plus-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#120B24"
    },
    "ios": { "supportsTablet": false },
    "android": {
      "package": "com.nexuswavetech.nexusplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated-branding/nexus-plus-1024.png",
        "backgroundColor": "#120B24"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "nexus-plus",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "favicon": "./assets/generated-branding/nexus-plus-192.png" },
    "plugins": [
      ["expo-router", { "origin": "https://replit.com/" }],
      "./plugins/withNexusNative",
      "expo-font",
      "expo-document-picker",
      "expo-web-browser",
      ["expo-camera", { "cameraPermission": "Allow Nexus Plus to use your camera for selfies." }],
      ["expo-notifications", { "defaultChannel": "nexus-alarm" }],
      "expo-local-authentication",
      "expo-secure-store"
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
