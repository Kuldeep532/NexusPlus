# ================================================================
# NEXUS PLUS — BUILD SECRETS TEMPLATE
# ================================================================
# Copy each VALUE into the corresponding GitHub Actions secret.
# Do NOT commit the filled file.
# ================================================================

# ---------- SUPABASE ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- FIREBASE CLIENT ----------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# One base64-encoded google-services.json value.
FIREBASE_GOOGLE_SERVICES_JSON_BASE64=

# ---------- EAS / EXPO ----------
EXPO_TOKEN=
EAS_PROJECT_ID=

# ---------- ANDROID STORE SIGNING FOR GITHUB ACTIONS ----------
# Base64-encoded existing .jks/.keystore file.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# ---------- GOOGLE PLAY STORE ----------
# Base64-encoded Google Play service-account JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PLAY_PACKAGE_NAME=com.nexuswavetech.nexusplus

# ---------- APPLE / APP STORE ----------
ASC_API_KEY_P8_BASE64=
ASC_KEY_ID=
ASC_ISSUER_ID=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.nexuswavetech.nexusplus

# ---------- IOS SIGNING ----------
IOS_DISTRIBUTION_CERT_P12_BASE64=
IOS_DISTRIBUTION_CERT_PASSWORD=
IOS_PROVISIONING_PROFILE_BASE64=

# ================================================================
# IMPORTANT
# 1. The GitHub Android CD workflow materializes the existing Android
#    keystore only at runner runtime, signs the release APK/AAB, and
#    deletes the keystore and key.properties afterwards.
# 2. EAS cloud builds use the Android credentials configured remotely
#    in EAS for the preview/production profiles. Configure the same
#    existing keystore in EAS once via `eas credentials --platform android`.
# 3. Never commit keystores, signing passwords, service-account keys,
#    or any other private credentials.
# ================================================================
