# ================================================================
# NEXUS PLUS — BUILD SECRETS TEMPLATE
# ================================================================
# Copy each VALUE into the corresponding GitHub Actions secret.
# Do NOT commit the filled file.
# ================================================================

# ---------- APP API GATEWAY ----------
# This is the ONLY API base URL embedded into the Android app.
# It is injected at build time through EXPO_PUBLIC_NEXUS_API_BASE_URL.
NEXUS_API_BASE_URL=

# ---------- FIREBASE CLIENT ----------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# One base64-encoded google-services.json value.
FIREBASE_GOOGLE_SERVICES_JSON_BASE64=

# ---------- EAS / EXPO ----------
EXPO_TOKEN=
EAS_PROJECT_ID=

# ---------- GOOGLE DRIVE CLIENT ----------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_ENABLED=false

# ---------- ANDROID STORE SIGNING FOR GITHUB ACTIONS ----------
# Base64-encoded existing .jks/.keystore file.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# ---------- GOOGLE PLAY STORE ----------
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PLAY_PACKAGE_NAME=com.nexuswavetech.nexusplus

# ---------- APPLE / APP STORE ----------
ASC_API_KEY_P8_BASE64=
ASC_KEY_ID=
ASC_ISSUER_ID=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.nexuswavetech.nexusplus

# ---------- IOS SIGNING ----------
IOS_DISTRIBUTION_CERT_P12_BASE64=
IOS_DISTRIBUTION_CERT_PASSWORD=
IOS_PROVISIONING_PROFILE_BASE64=

# ================================================================
# IMPORTANT
# 1. NEXUS_API_BASE_URL is a public gateway URL, not a secret credential.
#    It is stored as a GitHub Environment secret/value only to keep the
#    endpoint out of source control and inject it at build time.
# 2. Provider API keys and service credentials MUST stay server-side in
#    Supabase Edge Function secrets. Never put those into EXPO_PUBLIC_*.
# 3. The Android workflow materializes temporary signing/config files only
#    during the build and deletes them afterward.
# ================================================================
