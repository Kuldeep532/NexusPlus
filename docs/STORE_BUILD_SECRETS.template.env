# ================================================================
# NEXUS PLUS — GITHUB ACTIONS SECRETS TEMPLATE
# ================================================================
# Copy each VALUE into one GitHub Actions secret with the exact name
# shown below. Do NOT commit the real values to this file.
# ================================================================

# ---------- SUPABASE ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- FIREBASE CLIENT ----------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Paste the complete base64-encoded google-services.json as ONE value.
FIREBASE_GOOGLE_SERVICES_JSON_BASE64=

# ---------- GITHUB / BUILD ----------
EXPO_TOKEN=
EAS_PROJECT_ID=

# ---------- ANDROID STORE SIGNING ----------
# Base64-encoded .jks/.keystore file.
ANDROID_KEYSTORE_BASE64=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# ---------- GOOGLE PLAY STORE ----------
# Base64-encoded Google Play service-account JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PLAY_PACKAGE_NAME=com.nexuswavetech.nexusplus

# ---------- APPLE / APP STORE ----------
# App Store Connect API key, preferably supplied as one base64 file value.
ASC_API_KEY_P8_BASE64=
ASC_KEY_ID=
ASC_ISSUER_ID=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.nexuswavetech.nexusplus

# ---------- IOS SIGNING ----------
# Base64-encoded distribution certificate (.p12) and provisioning profile.
IOS_DISTRIBUTION_CERT_P12_BASE64=
IOS_DISTRIBUTION_CERT_PASSWORD=
IOS_PROVISIONING_PROFILE_BASE64=

# ================================================================
# IMPORTANT
# 1. This template is documentation only; the workflow reads GitHub
#    Actions secrets by name.
# 2. Client Firebase/Supabase values are embedded at runtime and are
#    not private credentials.
# 3. Never put Firebase service-account private keys in the app.
# 4. Store signing credentials only in GitHub Secrets/Environment.
# ================================================================
