# ================================================================
# NEXUS PLUS — BUILD SECRETS TEMPLATE
# ================================================================
# Copy each VALUE into the corresponding GitHub Actions secret.
# Do NOT commit the filled file.
# ================================================================

# ---------- APP API GATEWAY ----------
# Testing mode: Supabase Edge Functions only.
# Current value:
# https://cpbwiarqlvtlnwbkmpws.supabase.co/functions
#
# Later, when Cloudflare is added, only this GitHub secret needs to change.
NEXUS_API_BASE_URL=

# ---------- FIREBASE CLIENT ----------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

FIREBASE_GOOGLE_SERVICES_JSON_BASE64=

# ---------- EAS / EXPO ----------
EXPO_TOKEN=
EAS_PROJECT_ID=

# ---------- GOOGLE DRIVE CLIENT ----------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_ENABLED=false

# ---------- ANDROID STORE SIGNING FOR GITHUB ACTIONS ----------
ANDROID_KEYSTORE_BASE64=
ANDROID_KEY_ALIAS=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# ---------- GOOGLE PLAY STORE ----------
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PLAY_PACKAGE_NAME=com.nexuswavetech.nexusplus

# ---------- APPLE / APP STORE ----------
ASC_API_KEY_P8_BASE64=
ASC_KEY_ID=
ASC_ISSUER_ID=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.nexuswavetech.nexusplus

# ---------- IOS SIGNING ----------
IOS_DISTRIBUTION_CERT_P12_BASE64=
IOS_DISTRIBUTION_CERT_PASSWORD=
IOS_PROVISIONING_PROFILE_BASE64=

# ================================================================
# IMPORTANT
# 1. NEXUS_API_BASE_URL is a public endpoint, not a secret credential.
# 2. During testing it points to Supabase Edge Functions only.
# 3. Provider API keys and service credentials remain in Supabase
#    Edge Function secrets and are never placed in EXPO_PUBLIC_*.
# 4. When Cloudflare is introduced later, only this one GitHub secret
#    needs to be changed; app code does not need another rewrite.
# ================================================================
