# Public/runtime values only. Never put service-account private keys here.
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_PIPER_EN_SOURCE=
EXPO_PUBLIC_PIPER_HI_SOURCE=

# CI/EAS secrets are configured in GitHub Environment: production
# GOOGLE_SERVICES_JSON   -> complete google-services.json content
# EXPO_TOKEN             -> Expo/EAS access token
# EAS_PROJECT_ID         -> EAS project UUID
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON -> optional Google Play submission credential
# FIREBASE_WEB_API_KEY   -> Firebase client API key, only if app code consumes it
# FIREBASE_AUTH_DOMAIN   -> Firebase Auth domain, if used
# FIREBASE_PROJECT_ID    -> Firebase project ID, if used
# FIREBASE_STORAGE_BUCKET -> Firebase Storage bucket, if used
# FIREBASE_MESSAGING_SENDER_ID -> Firebase Messaging sender ID, if used
# FIREBASE_APP_ID        -> Firebase Web/App ID, if used
