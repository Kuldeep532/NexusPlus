#!/usr/bin/env sh

set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

if [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
  JAVACMD="${JAVA_HOME}/bin/java"
elif command -v java >/dev/null 2>&1; then
  JAVACMD=$(command -v java)
else
  echo "ERROR: JAVA_HOME is not set and java is not available on PATH." >&2
  exit 1
fi

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ -f "$WRAPPER_JAR" ]; then
  exec "$JAVACMD" -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
fi

# CI may use a managed/system Gradle distribution when the wrapper JAR is not
# checked in. This keeps the launcher compatible with the repository's pinned
# Gradle distribution metadata without requiring a binary artifact in Git.
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

echo "ERROR: Gradle wrapper JAR is missing and gradle is not available on PATH." >&2
exit 1
